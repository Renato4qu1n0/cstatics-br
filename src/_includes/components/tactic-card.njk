<article class="tactic-card hud" data-tactic data-reveal data-map="{{ tactic.mapSlug or (tactic.map | lower) }}" data-side="{{ tactic.side }}" data-category="{{ tactic.category }}">
  <i class="hud-brackets" aria-hidden="true"></i>
  <div class="scan" aria-hidden="true"></div>
  <div class="tactic-card__image">
    <img src="/{{ tactic.image }}" alt="{{ tactic.title }}" loading="lazy" decoding="async">
  </div>

  <div class="tactic-card__content">
    <div class="tactic-card__tags">
      <span class="tag tag--{{ tactic.side }}">{{ "T" if tactic.side == "t-side" else "CT" }}</span>
      <span class="tag tag--map">{{ tactic.map }}</span>
    </div>

    <h3 class="tactic-card__title">{{ tactic.title }}</h3>

    <p class="tactic-card__description">{{ tactic.shortDescription }}</p>

    <div class="tactic-card__stats">
      <div class="stat">
        <span class="stat__label">Taxa de Sucesso</span>
        <span class="stat__value">{{ tactic.successRate or "—" }}%</span>
      </div>
      <div class="stat">
        <span class="stat__label">Dificuldade</span>
        <span class="stat__value">{{ tactic.difficultyLabel or (tactic.difficulty ~ "/10") }}</span>
      </div>
    </div>

    <a href="/tactics/{{ tactic.slug }}/" class="tactic-card__link">
      Ver Detalhes →
    </a>
  </div>
</article>
